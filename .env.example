# HTTP server
PORT=3000
# Optional: set to a trusted reverse proxy count/address in production. Leave unset otherwise.
TRUST_PROXY=
# Exact browser origins allowed to call the API from a separately hosted frontend.
# For GitHub Pages, use https://<owner>.github.io (no project path).
CORS_ORIGINS=

# Executables (yt-dlp can be installed with pip; ffmpeg must be on PATH)
YTDLP_BIN=yt-dlp
FFMPEG_BIN=ffmpeg

# Optional yt-dlp tuning for difficult sources. Leave unset for yt-dlp's defaults.
# YouTube refuses many data-center addresses ("Sign in to confirm you're not a bot"), so the
# server automatically retries YouTube links once with alternate player clients.
# Path to a Netscape cookies.txt file (e.g. exported from a throwaway YouTube account).
# The file must be readable by the user running the server. Never use a personal account.
YTDLP_COOKIES=
# Extra yt-dlp plugin directories, e.g. `default` to load an installed PO-token provider.
YTDLP_PLUGIN_DIRS=
# Raw --extractor-args value, e.g. youtube:player_client=tv,web_safari
# Setting this also disables the automatic client retry, so list every client you want here.
YTDLP_EXTRACTOR_ARGS=
# Player clients used for the automatic YouTube retry, or `off` to disable the retry.
YTDLP_YOUTUBE_CLIENTS=tv_downgraded,web_embedded,web_safari,android,ios
# Pause between HTTP requests, in seconds, to stay under YouTube's rate limit.
YTDLP_SLEEP_REQUESTS=
# Cap the download speed, e.g. 2M.
YTDLP_LIMIT_RATE=
# Set to 1 to log yt-dlp's last stderr lines for failed extractions (operator debugging).
YTDLP_DEBUG=

# yt-dlp process limits
ANALYZE_TIMEOUT_MS=45000
DOWNLOAD_TIMEOUT_MS=900000
MAX_DOWNLOAD_BYTES=2147483648
MAX_CONCURRENT_DOWNLOADS=2

# Per-process API rate limits
API_RATE_LIMIT_PER_MINUTE=60
ANALYZE_RATE_LIMIT_PER_MINUTE=12
DOWNLOAD_RATE_LIMIT_PER_MINUTE=10
THUMBNAIL_RATE_LIMIT_PER_MINUTE=120
