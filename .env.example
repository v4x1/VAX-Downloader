# HTTP server
PORT=3000
# Optional: set to a trusted reverse proxy count/address in production. Leave unset otherwise.
TRUST_PROXY=
# Exact browser origins allowed to call the API from a separately hosted frontend.
# For GitHub Pages, use https://<owner>.github.io (no project path).
CORS_ORIGINS=

# Executables (yt-dlp can be installed with pip; ffmpeg must be on PATH)
YTDLP_BIN=yt-dlp
FFMPEG_BIN=ffmpeg

# yt-dlp process limits
ANALYZE_TIMEOUT_MS=45000
DOWNLOAD_TIMEOUT_MS=900000
MAX_DOWNLOAD_BYTES=2147483648
MAX_CONCURRENT_DOWNLOADS=2

# Per-process API rate limits
API_RATE_LIMIT_PER_MINUTE=60
ANALYZE_RATE_LIMIT_PER_MINUTE=12
DOWNLOAD_RATE_LIMIT_PER_MINUTE=10
THUMBNAIL_RATE_LIMIT_PER_MINUTE=120
